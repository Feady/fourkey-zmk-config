/*
 * fourkey_oled keymap - B26「层即页面」
 *
 * 物理布局：2×2 直连按键（先第一排从左到右，再第二排）
 *   ┌──────────┬──────────┐
 *   │ K1 左上  │ K2 右上  │   位置索引 0..3 = K1..K4
 *   ├──────────┼──────────┤
 *   │ K3 左下  │ K4 右下  │
 *   └──────────┴──────────┘
 *
 * B26 变更（针对"蓝牙键无效果 / 子层按键无效"）：
 *  1) combo timeout 30ms -> 100ms。官方示例 50ms，30ms 对手指太短，
 *     K1+K2 经常只按出一个键，进不了 Menu 页，导致后面整串操作失效。
 *  2) 新增 combo K3+K4 = &out OUT_BLE（强制首选 BLE）。
 *     ZMK 的 preferred transport 存在 NVS，插着 USB 时被存成 USB；
 *     拔线后 fallback 依赖 BLE profile 已连接，没连上就整个 endpoint=NONE，
 *     所有键（包括蓝牙键）看起来都没效果。OUT_BLE 直接把首选切到 BLE。
 *  3) 出蓝牙页多一条路：Default 页 K3+K4 = OUT_BLE 广播等配对。
 *
 * 屏幕上的 2×2 键位标签由 custom_status_screen.c 运行时读取本文件
 * （以及 ZMK Studio 保存的在线改键）生成，改键后屏幕自动同步。
 *
 * 层序（Studio 里可重命名/重排，屏幕读的是真实层名）：
 *   0 Default / 1 Menu / 2 Num / 3 Media / 4 Sys / 5 Fn
 *   6,7 = reserved（Studio 备用层）
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        /* 逻辑功能键：K1+K2 = 打开菜单页。
           timeout-ms=100：给手指足够的同步窗口（官方示例 50ms）。
           require-prior-idle-ms=80 防止连续快速按 K1、K2 时误触发。 */
        combo_menu {
            timeout-ms = <100>;
            require-prior-idle-ms = <80>;
            key-positions = <0 1>;
            layers = <0>;
            bindings = <&to 1>;
        };

        /* 强制切到 BLE 输出：只在 Default 页生效。
           解决"拔 USB 后连不上蓝牙、按键全无效"——把首选输出从
           残留的 USB 改成 BLE，ZMK 随即广播/回连已配对主机。 */
        combo_ble {
            timeout-ms = <100>;
            require-prior-idle-ms = <80>;
            key-positions = <2 3>;
            layers = <0>;
            bindings = <&out OUT_BLE>;
        };
    };

    macros {
        /* Alt+Tab 切换器：
           按下 -> 按住 LALT + 敲一次 TAB；
           &macro_pause_for_release -> 剩余部分等按键释放才执行；
           释放 -> 释放 LALT。
           短按 = 一次完整 Alt+Tab；长按 = 任务切换器保持显示。 */
        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <30>;
            bindings = <
                &macro_press   &kp LALT
                &macro_tap     &kp TAB
                &macro_pause_for_release
                &macro_release &kp LALT
            >;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
                &kp LC(C)       &kp LC(V)
                &kp LC(D)       &alt_tab
            >;
        };

        menu_layer {
            display-name = "Menu";
            bindings = <
                &to 2           &to 3
                &to 4           &to 0
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                &kp N1          &kp N2
                &kp N3          &to 0
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
                &kp C_VOL_DN    &kp C_VOL_UP
                &kp C_MUTE      &to 0
            >;
        };

        sys_layer {
            display-name = "Sys";
            bindings = <
                &bt BT_SEL 0    &bt BT_SEL 1
                &to 5           &to 0
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
                &studio_unlock  &bt BT_CLR
                &out OUT_USB    &to 0
            >;
        };

        /* Studio 专用备用层：普通构建忽略（reserved），
           启用 ZMK Studio 后可在 UI 里启用并自由改键。 */
        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};
