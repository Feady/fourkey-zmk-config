/*
 * fourkey_oled keymap - B31「层即页面」(蓝牙精简为 2 档)
 *
 * 物理布局：2×2 直连按键（先第一排从左到右，再第二排）
 *   ┌──────────┬──────────┐
 *   │ K1 左上  │ K2 右上  │   位置索引 0..3 = K1..K4
 *   ├──────────┼──────────┤
 *   │ K3 左下  │ K4 右下  │
 *   └──────────┴──────────┘
 *
 * B31 变更 —— 蓝牙精简（用户只需要 2 个蓝牙档位）：
 *   - 删除 Fn 页 K3 的 &bt BT_SEL 2（第 3 档），改为 &none；
 *     现在只有 Sys 页 K1=BT_SEL 0、K2=BT_SEL 1 两个选档键。
 *   - 保留 Fn 页 K2 的 &bt BT_CLR（清配对）——排障必需，不算"蓝牙档位"。
 *   - 屏幕显示同步简化：BT_SEL0/1 显示 B0/B1，BT_CLR 显示 CLR；
 *     顶栏 BLE 连接时显示当前档位 B0/B1，选档后短暂显示 ->B0/->B1 作反馈。
 *
 * B29 变更 —— 蓝牙回退到 B24（用户确认 B24 蓝牙正常）：
 *   B26/B27 为"修蓝牙"加的三处改动是回归源，全部移除：
 *   1) combo_btclr (K1+K4 = BT_SEL 0 + BT_CLR)：日常 Ctrl+C→Alt+Tab
 *      切换窗口时，K1 后紧接 K4 会在 combo 窗口内误触发清配对，
 *      bond 被反复清掉 → 表现就是"连上就断/连不上"。
 *   2) combo_ble (K3+K4 = OUT_BLE)：Ctrl+D→Alt+Tab 误触发会把正在用的
 *      USB 输出强制切到 BLE → 键盘无响应。
 *   3) conf 里的 ZMK_BLE_EXPERIMENTAL_CONN / BT_SMP_ALLOW_UNAUTH_OVERWRITE
 *      两个实验开关，B24 均未开启也能正常配对连接，一并移除。
 *   Fn 页 K3 恢复为 &bt BT_SEL 2（B24 原样）。
 *   仅保留 combo_menu timeout=100ms（与蓝牙无关，改善进菜单手感）。
 *
 * 屏幕上的 2×2 键位标签由 custom_status_screen.c 运行时读取本文件
 * （以及 ZMK Studio 保存的在线改键）生成，改键后屏幕自动同步。
 *
 * 层序（Studio 里可重命名/重排，屏幕读的是真实层名）：
 *   0 Default / 1 Menu / 2 Num / 3 Media / 4 Sys / 5 Fn
 *   6,7 = reserved（Studio 备用层）
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";

        /* 逻辑功能键：K1+K2 = 打开菜单页。
           layers = <0> 只在 Default 页生效；require-prior-idle-ms 防止
           连续快速按 K1、K2 时误触发（官方文档 combos.md）。 */
        combo_menu {
            timeout-ms = <100>;
            require-prior-idle-ms = <80>;
            key-positions = <0 1>;
            layers = <0>;
            bindings = <&to 1>;
        };
    };

    macros {
        /* Alt+Tab 切换器：
           按下 -> 按住 LALT + 敲一次 TAB；
           &macro_pause_for_release -> 剩余部分等按键释放才执行；
           释放 -> 释放 LALT。
           短按 = 一次完整 Alt+Tab；长按 = 任务切换器保持显示。 */
        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <30>;
            bindings = <
                &macro_press   &kp LALT
                &macro_tap     &kp TAB
                &macro_pause_for_release
                &macro_release &kp LALT
            >;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
                &kp LC(C)       &kp LC(V)
                &kp LC(D)       &alt_tab
            >;
        };

        menu_layer {
            display-name = "Menu";
            bindings = <
                &to 2           &to 3
                &to 4           &to 0
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                &kp N1          &kp N2
                &kp N3          &to 0
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
                &kp C_VOL_DN    &kp C_VOL_UP
                &kp C_MUTE      &to 0
            >;
        };

        sys_layer {
            display-name = "Sys";
            bindings = <
                &bt BT_SEL 0    &bt BT_SEL 1
                &to 5           &to 0
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
                &studio_unlock  &bt BT_CLR
                &none           &to 0
            >;
        };

        /* Studio 专用备用层：普通构建忽略（reserved），
           启用 ZMK Studio 后可在 UI 里启用并自由改键。 */
        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};
