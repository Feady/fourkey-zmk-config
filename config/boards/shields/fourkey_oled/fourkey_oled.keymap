/*
 * fourkey_oled keymap — 占位映射，板上手后按需改
 *
 * 物理位置（1×4）：
 *   ┌──────────────┬──────────────┐
 *   │ 0  K1=D8     │ 1  K2=D5     │
 *   ├──────────────┼──────────────┤
 *   │ 2  K3=D7     │ 3  K4=D6     │
 *   └──────────────┴──────────────┘
 *
 * 默认层：K1 播放/暂停  K2 音量−  K3 音量+  K4 长按进 Fn 层 / 短按静音
 * Fn 层： K1 配对设备0  K2 配对设备1  K3 清除配对  K4 进 UF2 刷机
 *
 * 改键速查（dt-bindings/zmk/keys.h）：
 *   &kp A~Z、&kp SPACE、&kp RET、&kp ESC、&kp TAB
 *   &kp C_PLAY_PAUSE / C_NEXT / C_PREV / C_VOL_UP / C_VOL_DN / C_MUTE
 *   &kp LC(X)（Ctrl+X）、LG(X)（Win/Cmd+X）、LA(X)（Alt+X）
 *   &bt BT_SEL 0~3 / BT_CLR / BT_PROF_NEXT / BT_PROF_CLR
 *   &sys_reset（重启固件）、&bootloader（进 UF2）、&soft_off（软关机）
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
/* dt-bindings/zmk/layers.h 已从 ZMK main 移除（层直接用层号/层名引用） */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Media";
            bindings = <
                &kp C_PLAY_PAUSE    &kp C_VOL_DN
                &kp C_VOL_UP        &lt NUM_1 C_MUTE
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
                &bt BT_SEL 0        &bt BT_SEL 1
                &bt BT_CLR          &bootloader
            >;
        };
    };
};
